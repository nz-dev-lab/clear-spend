FROM node:20-alpine

# Prisma requires OpenSSL to connect to the database securely
RUN apk add --no-cache openssl

WORKDIR /app

# Copy dependency files first (better Docker layer caching — only re-installs when package.json changes)
COPY package*.json ./
RUN npm install

# Copy the rest of the source code
COPY . .

EXPOSE 3000

# Start NestJS in watch mode so it auto-reloads on code changes during development
CMD ["npm", "run", "start:dev"]
